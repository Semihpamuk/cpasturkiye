# ─────────────────────────────────────────────────────────────────────────────
# Admin Paneli (/admin)
# ─────────────────────────────────────────────────────────────────────────────
# Production'da MUTLAKA değiştir — varsayılan değer güvensizdir
ADMIN_PASSWORD=guclu-bir-sifre-sec
ADMIN_SECRET=en-az-32-karakter-rastgele-bir-string-gir

# ─────────────────────────────────────────────────────────────────────────────
# iyzico Ödeme Altyapısı
# Sandbox: https://sandbox.iyzipay.com → API Keys bölümünden al
# Production: https://merchant.iyzipay.com → API Keys bölümünden al
# ─────────────────────────────────────────────────────────────────────────────
IYZICO_API_KEY=sandbox-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
IYZICO_SECRET_KEY=sandbox-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Sandbox test için: https://sandbox-api.iyzipay.com
# Production için:   https://api.iyzipay.com
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# ─────────────────────────────────────────────────────────────────────────────
# E-posta (SMTP) — Sipariş bildirimleri ve müşteri onay e-postaları için
# Gmail örneği: SMTP_HOST=smtp.gmail.com, PORT=587, SMTP_USER=hesap@gmail.com
# Uygulama şifresi: https://myaccount.google.com/apppasswords
# ─────────────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=info@cpasturkiye.com
SMTP_PASS=uygulamasifreniziburayin

# ─────────────────────────────────────────────────────────────────────────────
# Site Bilgileri (iyzico başvurusu ve yasal uyumluluk için)
# NEXT_PUBLIC_ prefix'li değişkenler tarayıcıya da gönderilir — hassas veri koyma
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_PHONE=+90 (212) 000 00 00
NEXT_PUBLIC_SITE_MERSIS=0187173437300001
NEXT_PUBLIC_SITE_TAX_OFFICE=Beşiktaş Vergi Dairesi
NEXT_PUBLIC_SITE_TAX_ID=1871734373
# Ticaret Sicil No — e-ticaret yasal bilgilendirme için zorunlu
NEXT_PUBLIC_SITE_TRADE_REGISTRY=1086253
# KEP adresi: Kayıtlı Elektronik Posta — iyzico başvurusunda zorunludur
NEXT_PUBLIC_SITE_KEP=jale@hs01.kep.tr

# ─────────────────────────────────────────────────────────────────────────────
# Canlı İstatistik Bandı — Jale panelinden (server-side) çekilir
# NEXT_PUBLIC_ DEĞİL: API anahtarı tarayıcıya gönderilmez.
# JALE_STATS_URL: Jale'nin public stats endpoint'i (tam URL)
# JALE_STATS_API_KEY: Jale .env'indeki PUBLIC_STATS_API_KEY ile birebir aynı olmalı
# Bu iki değer boşsa band hiç gösterilmez (site bozulmaz).
# ─────────────────────────────────────────────────────────────────────────────
JALE_STATS_URL=https://jale.cpasturkiye.com/api/public/stats
JALE_STATS_API_KEY=jale-public-stats-api-key

# ─────────────────────────────────────────────────────────────────────────────
# Jale kurulum daveti köprüsü — ödeme onaylanınca müşteriye kurulum linki üretir
#
# Akış: iyzico ödemeyi onaylar → /api/payment/callback Jale'nin
#   /api/public/onboarding-invite ucunu çağırır → dönen /portal/register?token=...
#   linki hem onay e-postasına konur hem müşteri oraya YÖNLENDİRİLİR.
#
# JALE_ONBOARDING_URL: Jale'nin public davet ucu (tam URL).
#   Host `jale.cpasturkiye.com`'dur — `panel.cpasturkiye.com` diye bir alan adı YOK
#   (2026-09-08'de ölçüldü, bağlantı kurulamıyor).
# JALE_SIGNUP_API_KEY: Jale .env'indeki PORTAL_SIGNUP_API_KEY ile BİREBİR aynı olmalı.
#   NEXT_PUBLIC_ DEĞİL: yalnız sunucuda okunur, tarayıcıya gönderilmez.
#   Sunucu tarafında okunur → Easypanel'de servis env'i yeterli (Build Arguments değil).
#
# İkisi de boşsa köprü PASİF kalır: ödeme sorunsuz tamamlanır ama müşteri kurulum
# linkini HİÇ ALMAZ ve normal başarı sayfasına düşer. Bu durum artık sessiz değil —
# konteyner logunda "[jaleOnboarding] Köprü PASİF — eksik env: ..." satırı belirir
# ve callback siparişi id'siyle birlikte uyarır.
# ─────────────────────────────────────────────────────────────────────────────
JALE_ONBOARDING_URL=https://jale.cpasturkiye.com/api/public/onboarding-invite
JALE_SIGNUP_API_KEY=jale-portal-signup-api-key

# ─────────────────────────────────────────────────────────────────────────────
# Google Analytics 4
#
# NEXT_PUBLIC_GA_ID: GA4 → Yönetici → Veri akışları → web akışı → Ölçüm Kimliği.
#   Boşsa gtag hiç yüklenmez (dev/preview prod verisini kirletmez).
#   DİKKAT: build zamanında bundle'a gömülür — değiştirince rebuild gerekir.
#   Docker/Easypanel'de servis env'i DEĞİL, "Build Arguments" altına girilmeli
#   (Dockerfile'da ARG olarak tanımlı). Runtime env'i olarak verilirse istemci
#   bundle'ında boş kalır ve ölçüm sessizce hiç çalışmaz.
#
# GA_MEASUREMENT_ID: NEXT_PUBLIC_GA_ID ile aynı değer, ama runtime'da okunur.
#   Sunucu tarafı Measurement Protocol bunu tercih eder; build arg unutulsa bile
#   ciroyu taşıyan `purchase` olayı çalışmaya devam etsin diye ayrı tutuluyor.
#
# GA_API_SECRET: Aynı veri akışı → "Measurement Protocol API gizli anahtarları".
#   NEXT_PUBLIC_ DEĞİL: yalnızca sunucuda kullanılır, tarayıcıya gönderilmez.
#   Sunucudan gönderilen `purchase` olayı bunsuz çalışmaz — ciro raporu boş kalır.
#   (Ödeme iyzico'da tamamlanıp harici portala yönlendiği için purchase
#    istemciden değil, sunucudan Measurement Protocol ile gönderilir.)
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
GA_MEASUREMENT_ID=G-XXXXXXXXXX
GA_API_SECRET=olculum-protokolu-api-gizli-anahtari

# ─────────────────────────────────────────────────────────────────────────────
# Meta (Facebook/Instagram) Pixel
#
# NEXT_PUBLIC_META_PIXEL_ID: Meta Events Manager → Veri Kaynakları → Pixel'iniz
#   → Ayarlar bölümündeki Pixel ID (15-16 haneli sayı).
#   Boşsa fbq hiç yüklenmez (dev/preview prod verisini kirletmez).
#   GA_ID gibi build zamanında bundle'a gömülür — değiştirince rebuild gerekir.
#   Docker/Easypanel'de servis env'i DEĞİL, "Build Arguments" altına girilmeli
#   (Dockerfile'da ARG olarak tanımlı).
#
#   ÖNEMLİ: Pixel de GA4 ile aynı çerez rızası (consent) kapısının arkasında
#   yüklenir — ziyaretçi bandı onaylamadan fbq hiç çalışmaz. Ancak sitenin
#   Çerez Politikası ve Gizlilik Politikası metinleri şu an "reklam çerezi
#   kullanmıyoruz" diyor; Pixel canlıya alınmadan bu metinlerin Meta Pixel'i
#   kapsayacak şekilde güncellenmesi gerekir (KVKK uyumu için).
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_META_PIXEL_ID=000000000000000

# ─────────────────────────────────────────────────────────────────────────────
# Google Search Console doğrulama
#
# NEXT_PUBLIC_GSC_VERIFICATION: Search Console → mülk ekle → URL öneki →
#   "HTML etiketi" yönteminde verilen <meta name="google-site-verification"
#   content="..."> etiketindeki content değeri. Yalnızca bu değeri girin,
#   etiketin tamamını değil.
#   Boşsa meta etiketi hiç basılmaz.
#   NEXT_PUBLIC_GA_ID gibi build zamanında gömülür → Easypanel'de "Build
#   Arguments" altına girilmeli, servis env'ine değil.
#
#   Alternatif: GA4 zaten kurulu olduğu için Search Console'da "Google
#   Analytics" doğrulama yöntemini de seçebilirsiniz; o yöntemde bu değişkene
#   gerek kalmaz (aynı Google hesabının GA4 mülkünde düzenleme yetkisi yeterli).
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_GSC_VERIFICATION=

# ─────────────────────────────────────────────────────────────────────────────
# SatisCRM entegrasyonu (opsiyonel — boşsa gönderim güvenle pasif kalır)
#
# Form başvuruları (lead) kaydedildikleri anda SatisCRM havuzuna iletilir.
# CRM FARKLI bir sunucuda (ayrı Easypanel VPS'i): URL dış HTTPS adresidir
#   (örn. https://satis.isimdijital.com/api/webhooks/website) — token + TLS korur.
# CRM_WEBHOOK_TOKEN, SatisCRM'deki WEBSITE_WEBHOOK_SECRET ile AYNI olmalı.
# Sunucu tarafında okunur → Easypanel'de servis env'i yeterli (Build Arguments değil).
# ─────────────────────────────────────────────────────────────────────────────
CRM_WEBHOOK_URL=
CRM_WEBHOOK_TOKEN=
